# Copie este arquivo para .env e defina senhas próprias.
# O .env nunca é commitado (veja .gitignore).

# Banco deste projeto, dentro do container PostgreSQL compartilhado.
# 127.0.0.1 e não "localhost": no Windows, localhost resolve primeiro para o IPv6 ::1,
# mas o container publica a porta só em 127.0.0.1 (IPv4); cada conexão esperaria o
# timeout do ::1 antes de tentar o IPv4.
VAREJO_DB_HOST=127.0.0.1
VAREJO_DB_PORT=5432
VAREJO_DB_NAME=retail
# Banco dos testes automatizados: é APAGADO e recriado a cada execução do pytest.
# Precisa ser diferente de VAREJO_DB_NAME (a configuração recusa se forem iguais).
VAREJO_DB_NAME_TESTE=retail_teste
VAREJO_DB_USER=varejo
VAREJO_DB_PASSWORD=troque_esta_senha

# Usuário SOMENTE LEITURA para o Power BI (vê os schemas analise e dq; não vê bruto
# nem limpo). Criado pelo bootstrap como membro do grupo varejo_leitura.
VAREJO_BI_USER=varejo_bi
VAREJO_BI_PASSWORD=troque_esta_outra_senha

# Container e superusuário usados só pelo "python -m varejo.bootstrap" (via docker exec,
# sem senha: dentro do container o psql conecta pelo socket local).
VAREJO_DOCKER_CONTAINER=honda-vendas-db
VAREJO_DOCKER_SUPERUSER=honda
