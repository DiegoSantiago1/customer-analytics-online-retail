/// Previsão do CLV feita em 10/06/2011, ingênuo e real, por cliente.
table clv_validacao_cliente
	lineageTag: 2ba7e05d-5f64-51ad-abb4-aa20e9ede582

	column cliente_id
		dataType: int64
		formatString: 0
		lineageTag: 9ba5f749-79d0-5205-af34-06e732a9b359
		summarizeBy: none
		sourceColumn: cliente_id

	column segmento
		dataType: string
