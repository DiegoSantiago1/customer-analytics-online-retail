	partition clv_validacao_cliente = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database("127.0.0.1", "retail"),
				    Tabela = Fonte{[Schema = "analise", Item = "clv_validacao_cliente"]}[Data]
